# MySQL. Replace with the connection URL from your hosting provider.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/pocoyo7x

# These values are supplied automatically by the Manus WebDev runtime.
# For a self-hosted deployment, configure the matching OAuth application values privately.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Email address of the account authorized to administer keys.
POCOYO_ADMIN_EMAIL=admin@example.com

PORT=3000
NODE_ENV=development
